# Browser-safe Supabase configuration. Values come from the existing Supabase
# project: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/deployment secret only. Never prefix this with NEXT_PUBLIC_ and never
# commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public application URL. Use the deployed HTTPS URL in Cloudflare.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: used only by local database audit and backup scripts. Never expose
# it to the browser or Cloudflare build output.
SUPABASE_DB_URL=
